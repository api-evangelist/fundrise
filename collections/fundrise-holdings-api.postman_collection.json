  "item": [
    {
      "id": "f84356d0-7ec6-48e4-880d-284c97519c41",
      "name": "Holdings",
      "description": {
        "content": "The Holdings API contains up-to-date information about the status and performance of a Client's holdings in Fundrise. This endpoint may be used to fetch holding information after a Client's initial Transaction has been  completed. The response from this endpoint will update daily with underlying changes in appreciation and accruing dividends.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "937b2324-ef7e-4195-a041-671fa9bc67e4",
          "name": "Get Offering Holdings",
          "request": {
            "name": "Get Offering Holdings",
            "description": {
              "content": "Returns a collection containing all of the Client's current holdings within Fundrise.  Filter on optional Offering ID to return holding on a specific Offering.\nThe `liquidable` fields indicates shareholdings that are available for liquidation. This is filterable by the `liquidable` query parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "account",
                ":accountId",
                "holdings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "offeringId",
                  "value": "<int64>"
                },
                {
                  "disabled": false,
                  "key": "liquidable",
                  "value": "<boolean>",
                  "description": "A filter for requesting only holdings which are eligible for Liquidation."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "accountId",
                  "description": "(Required) The account ID (returned by the <a href=\"#tag/Clients/operation/CreateClient\">Create Client operation</a> or the <a href=\"#tag/Clients/operation/GetClient\">Get Client operation</a>) associated with the request."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
