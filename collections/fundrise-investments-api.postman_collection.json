                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"partnerReferenceId\": \"2314\",\n  \"offeringId\": \"1\",\n  \"acknowledgedDocumentIds\": [\n    \"1\",\n    \"2\"\n  ],\n  \"amount\": \"24187.50\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
