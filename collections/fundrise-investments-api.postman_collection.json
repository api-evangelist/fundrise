              ],
              "body": "{\n  \"transactionId\": \"11\",\n  \"transactionType\": \"INVESTMENT\",\n  \"description\": \"Investment into Fundrise Offering\",\n  \"amount\": \"10000.00\",\n  \"transactionDate\": \"2023-02-15T00:00:00.000-05:00\",\n  \"offerings\": [\n    {\n      \"offeringId\": \"24\",\n      \"offeringName\": \"Flagship Fund\",\n      \"sharePrice\": \"10.04\",\n      \"shares\": \"996.015936\"\n    }\n  ],\n  \"status\": \"PENDING\",\n  \"isCancellable\": true,\n  \"debitCreditMemo\": \"CREDIT\"\n}",
