                  "raw": "{\n  \"allAcknowledgmentsAccepted\": true,\n  \"offerings\": [\n    {\n      \"offeringId\": \"1\",\n      \"shares\": \"10.000001\"\n    },\n    {\n      \"offeringId\": \"2\",\n      \"shares\": \"25.000001\"\n    }\n  ]\n}",
                  "options": {
