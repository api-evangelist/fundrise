        {
          "id": "e5a3f869-b6fc-4fd9-9dda-c012f0cdac23",
          "name": "Get Investment Acknowledgments",
          "request": {
            "name": "Get Investment Acknowledgments",
            "description": {
              "content": "This endpoint provides access to Fundrise Offering acknowledgments required to place Investments. When a user has selected what Offering they would like to invest in from the `GET /v1/offerings` endpoint, the acknowledgments must be displayed to the user and the user must  digitally sign the acknowledgments and submit the IDs when investing into the Offering. Digitally signing means the Partner platform must display associated checkboxes for each acknowledgement and require the user to check them to proceed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "offering",
                ":offeringId",
                "acknowledgments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<int64>",
                  "key": "offeringId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
