                  "value": "application/json"
                }
              ],
              "body": "{\n  \"clientId\": \"1\",\n  \"refreshToken\": \"2b1a7986-a277-41e4-b153-688f84b6edcb\",\n  \"accounts\": [\n    {\n      \"accountId\": \"12\"\n    }\n  ]\n}",
